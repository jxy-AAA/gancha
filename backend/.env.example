# 服务端口
PORT=8081

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=guangyanji
DB_PASSWORD=guangyanji_dev
DB_NAME=guangyanji

# JWT 密钥（生产环境务必改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-secret

# 附件存储目录（相对 backend/ 目录）
UPLOAD_DIR=uploads

# 前端构建产物目录（如 frontend/dist，设置后由后端直接托管页面与 API，单端口部署）
# FRONTEND_DIST=../frontend/dist

# 是否允许注册
REGISTER_ENABLED=true
